# Go binary built from `make build`
/basalisk

# Go test + build artefacts
*.exe
*.test
*.out
coverage.out

# Frontend
frontend/node_modules/
frontend/dist/

# Built Sysop UI assets — produced by `make ui-build`, embedded by Go.
# The dist/ directory and its .gitkeep are kept so `//go:embed` compiles.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# Local browser verification and private app data
.playwright-mcp/
*.db
*.db-shm
*.db-wal
/data/

# Cerberus deploy state and local operator config. Real config lives under
# $XDG_CONFIG_HOME/basalisk, never in the repo; only *.example files are tracked.
.cerberus-build.lock
/bin/
*.env
!*.example.env
/config/*
!/config/*.example.*
*.local.json
*.local.yaml
