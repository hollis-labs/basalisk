{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hollis-labs.dev/fragments-engine/browser-capture-reader/v1/conversation-ref.schema.json",
  "title": "ConversationRef",
  "description": "Reference to a conversation owned by an external application/provider. Messages and session lifecycle are not FE state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fragment_id",
    "owning_application",
    "conversation_id",
    "pinned_starting_revision_id",
    "created_by_actor",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "fe.reader.conversation-ref.v1"
    },
    "fragment_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "owning_application": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "conversation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "pinned_starting_revision_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "created_by_actor": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  }
}
