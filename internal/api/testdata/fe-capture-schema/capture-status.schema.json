{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hollis-labs.dev/fragments-engine/browser-capture-reader/v1/capture-status.schema.json",
  "title": "CaptureStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "fragment_id",
    "fragment_revision_id",
    "capture_attempt_id",
    "completion",
    "assets",
    "enrichment_in_progress",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "fe.capture.status.v1"
    },
    "capture_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "fragment_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "fragment_revision_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "capture_attempt_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "completion": {
      "type": "string",
      "enum": ["accepting", "transferring", "complete", "partial", "failed"]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "media.schema.json#/$defs/AssetOutcome"
      }
    },
    "enrichment_in_progress": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ContractWarning"
      }
    }
  }
}
