{
  "version": "basalisk-default-1",
  "strategy": "first_match",
  "rules": [
    {
      "id": "help",
      "when": [
        {
          "field": "slash",
          "op": "in",
          "values": [
            "help",
            "?"
          ]
        }
      ],
      "target": "help",
      "auto": true
    },
    {
      "id": "open-app",
      "when": [
        {
          "field": "slash",
          "op": "eq",
          "value": "open"
        },
        {
          "field": "app",
          "op": "exists"
        }
      ],
      "target": "tool:desktop_open",
      "params": {
        "app": "{app}",
        "_say": "Opened {app_title}.",
        "_help": "/open <app>: open an app, or bring its window forward. \"open notes\" does the same."
      },
      "auto": true
    },
    {
      "id": "open-app-named",
      "when": [
        {
          "field": "slash_app",
          "op": "eq",
          "value": "yes"
        }
      ],
      "target": "tool:desktop_open",
      "params": {
        "app": "{app}",
        "_say": "Opened {app_title}.",
        "_help": "/<app>: open that app, for example /terminal or /notes."
      },
      "auto": true
    },
    {
      "id": "open-app-said",
      "when": [
        {
          "field": "verb",
          "op": "in",
          "values": [
            "open",
            "launch",
            "start",
            "show"
          ]
        },
        {
          "field": "app",
          "op": "exists"
        }
      ],
      "target": "tool:desktop_open",
      "params": {
        "app": "{app}",
        "_say": "Opened {app_title}."
      },
      "auto": true
    },
    {
      "id": "command",
      "when": [
        {
          "field": "slash",
          "op": "in",
          "values": [
            "do",
            "cmd"
          ]
        },
        {
          "field": "command",
          "op": "exists"
        }
      ],
      "target": "tool:desktop_run_command",
      "params": {
        "command": "{command}",
        "_say": "Done: {command_title}.",
        "_help": "/do <command>: run a command from the palette, by its title. Typing the title alone does the same."
      },
      "auto": true
    },
    {
      "id": "command-said",
      "when": [
        {
          "field": "said",
          "op": "eq",
          "value": "yes"
        },
        {
          "field": "command",
          "op": "exists"
        }
      ],
      "target": "tool:desktop_run_command",
      "params": {
        "command": "{command}",
        "_say": "Done: {command_title}."
      },
      "auto": true
    },
    {
      "id": "run",
      "when": [
        {
          "field": "slash",
          "op": "eq",
          "value": "run"
        },
        {
          "field": "arg",
          "op": "exists"
        }
      ],
      "target": "tool:terminal_run",
      "params": {
        "command": "{arg}",
        "_say": "Ran it in the terminal.",
        "_help": "/run <command line>: run it in a terminal. You are asked first, every time."
      },
      "auto": true
    },
    {
      "id": "task",
      "when": [
        {
          "field": "slash",
          "op": "eq",
          "value": "task"
        },
        {
          "field": "arg",
          "op": "exists"
        }
      ],
      "target": "tool:task_start",
      "params": {
        "brief": "{arg}",
        "_say": "Started a task agent on it. It works in the background; its window shows how it is going.",
        "_help": "/task <what to do>: hand it to a task agent that works in the background."
      },
      "auto": true
    },
    {
      "id": "scratch",
      "when": [
        {
          "field": "slash",
          "op": "in",
          "values": [
            "s",
            "scratch"
          ]
        },
        {
          "field": "arg",
          "op": "exists"
        }
      ],
      "target": "tool:scratch_add",
      "params": {
        "text": "{arg}",
        "_say": "Kept in scratch.",
        "_help": "/s <text>: keep it in your scratch (::idea, ::follow-up, $ command, +project all work)."
      },
      "auto": true
    }
  ]
}
