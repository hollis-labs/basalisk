{
  "name": "basalisk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "manifest": "go run github.com/hollis-labs/substrate/cmd/substrate frontend -f ../cmd/basalisk/substrate.yaml -o src/generated",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && npm run lint:design",
    "lint:design": "eslint src",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hollis-labs/app-shell": "0.1.0",
    "@hollis-labs/design-app-runtime": "0.5.0",
    "@hollis-labs/design-bindings": "0.2.0",
    "@hollis-labs/design-components": "0.5.1",
    "@hollis-labs/design-tokens": "0.5.0",
    "@hollis-labs/kit-account": "0.1.0",
    "@hollis-labs/kit-dashboard": "0.6.0",
    "@hollis-labs/kit-settings": "0.2.0",
    "@hollis-labs/plugin-host-ui": "0.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.11.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@hollis-labs/eslint-config-design": "0.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "7.3.6"
  }
